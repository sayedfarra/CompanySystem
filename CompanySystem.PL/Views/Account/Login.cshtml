@model CompanySystem.BLL.ViewModels.Account.LoginVM

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-card glass-card">
    <div class="card-header-glass">
        <h4><i class="fas fa-sign-in-alt me-2"></i>Log In</h4>
    </div>
    <div class="card-body-glass form-glass" style="max-width:100%;">
        <form asp-controller="Account" asp-action="Login" method="post" asp-route-returnurl="@ViewData["ReturnUrl"]">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label"><i class="fas fa-envelope me-1"></i> Email</label>
                <input asp-for="Email" class="form-control" placeholder="you@example.com" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"><i class="fas fa-lock me-1"></i> Password</label>
                <input asp-for="Password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="mb-3 form-check">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn-gradient w-100">
                <i class="fas fa-arrow-right"></i> Log in
            </button>
        </form>
    </div>
    <div class="card-footer-glass">
        <p style="margin:0;">Don't have an account? <a asp-action="Register" class="text-gradient" style="font-weight:600;">Register here</a></p>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
