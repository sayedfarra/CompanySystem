@model CategoryReadVM

<div class="page-header">
    <h1><i class="fas fa-tag me-2"></i>Category Details</h1>
</div>

<div class="glass-card p-4" style="max-width:800px; margin:0 auto;">
    <div class="d-flex align-items-center gap-3 mb-4">
        <div class="badge-accent" style="font-size:1rem; padding:0.5rem 1.2rem;">
            <i class="fas fa-hashtag me-1"></i>@Model.Id
        </div>
        <h2 style="font-weight:800; margin:0;">@Model.Name</h2>
    </div>

    <h4 style="font-weight:700; margin-bottom:1rem;">
        <i class="fas fa-box me-2 text-gradient"></i>Products in this Category
    </h4>

    @if (Model.Products != null && Model.Products.Any())
    {
        <div class="glass-card" style="overflow:hidden;">
            <table class="table-glass">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Price</th>
                        <th>Count</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var prod in Model.Products)
                    {
                        <tr>
                            <td><strong>@prod.Id</strong></td>
                            <td>@prod.Title</td>
                            <td>@prod.Description</td>
                            <td><span class="text-gradient" style="font-weight:700;">@prod.Price.ToString("N0")</span></td>
                            <td>@prod.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="glass-card p-4 text-center" style="color:var(--text-muted);">
            <i class="fas fa-inbox d-block" style="font-size:2rem; margin-bottom:0.5rem;"></i>
            No products in this category.
        </div>
    }

    <div class="mt-4">
        <a asp-controller="Category" asp-action="Index" class="btn-glass">
            <i class="fas fa-arrow-left"></i> Back to Categories
        </a>
    </div>
</div>
