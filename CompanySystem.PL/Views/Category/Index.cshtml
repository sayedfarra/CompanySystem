@model IEnumerable<CategoryReadVM>

<div class="page-header">
    <h1><i class="fas fa-tags me-2"></i>All Categories</h1>
    <p>Manage your product categories</p>
</div>

<div class="d-flex justify-content-end mb-4">
    <a asp-controller="Category" asp-action="Create" class="btn-gradient">
        <i class="fas fa-plus"></i> Create New Category
    </a>
</div>

<div class="glass-card" style="overflow:hidden;">
    <table class="table-glass">
        <thead>
            <tr>
                <th><i class="fas fa-hashtag me-1"></i> ID</th>
                <th><i class="fas fa-tag me-1"></i> Name</th>
                <th><i class="fas fa-cog me-1"></i> Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var cat in Model)
            {
                <tr>
                    <td><strong>@cat.Id</strong></td>
                    <td>@cat.Name</td>
                    <td>
                        <div class="d-flex gap-2 flex-wrap">
                            <a asp-controller="Category" asp-action="Details" asp-route-id="@cat.Id" class="btn-glass btn-sm-glass">
                                <i class="fas fa-eye"></i> Details
                            </a>
                            <a asp-controller="Category" asp-action="Edit" asp-route-id="@cat.Id" class="btn-glass btn-sm-glass">
                                <i class="fas fa-pen"></i> Edit
                            </a>
                            <button type="button" class="btn-danger-glass btn-sm-glass" data-bs-toggle="modal" data-bs-target="#deleteModal"
                                    data-category-id="@cat.Id"
                                    data-categoryName="@cat.Name">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2" style="color:var(--danger);"></i>Delete Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="categoryTitle" class="text-gradient">category</strong>?
                <br><small style="color:var(--text-muted);">This action cannot be undone.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-danger-glass" id="deletBtn">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;

            const categoryId = button.getAttribute('data-category-id');
            const categoryName = button.getAttribute('data-categoryName');

            document.getElementById('categoryTitle').textContent = categoryName;

            document.getElementById('deletBtn').onclick = function() {
                window.location.href = '/Category/Delete/' + categoryId;
            };
        });
    </script>
}
