@model CategoryCreateVM

<div class="page-header">
    <h1><i class="fas fa-plus-circle me-2"></i>Add New Category</h1>
    <p>Create a new category for your products</p>
</div>

<div class="glass-card p-4 form-glass">
    @using (Html.BeginForm("Create", "Category", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label"><i class="fas fa-tag me-1"></i> Category Name</label>
            @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Enter Category Name" })
            @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger" })
        </div>

        <div class="d-flex justify-content-center gap-3">
            <button type="submit" class="btn-gradient">
                <i class="fas fa-check"></i> Create Category
            </button>
            <a asp-controller="Category" asp-action="Index" class="btn-glass">
                <i class="fas fa-times"></i> Cancel
            </a>
        </div>
    }
</div>

@section scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
