@model List<ProductReadVM>

<div class="page-header">
    <h1><i class="fas fa-box me-2"></i>All Products</h1>
    <p>Browse our complete product catalog</p>
</div>

<div class="d-flex justify-content-end mb-4">
    <a asp-controller="Product" asp-action="Create" class="btn-gradient">
        <i class="fas fa-plus"></i> Add New Product
    </a>
</div>

<div class="products-grid">
    @foreach (var prod in Model)
    {
        <div class="product-card">
            <div class="product-card-img-wrapper">
                @if (!string.IsNullOrEmpty(prod.ImageUrl))
                {
                    <img src="@prod.ImageUrl" alt="@prod.Title" class="product-card-img" />
                }
                else
                {
                    <div class="no-image">
                        <i class="fas fa-image"></i>
                    </div>
                }
                <span class="badge-accent badge-category">@prod.Category</span>
            </div>
            <div class="product-card-body">
                <div class="product-card-title">@prod.Title</div>
                <div class="product-card-desc">@prod.Description</div>
                <div class="product-card-meta">
                    <span class="product-price">@prod.Price.ToString("N0") EGP</span>
                    <span class="product-count"><i class="fas fa-cubes me-1"></i>@prod.Count in stock</span>
                </div>
                <div class="product-card-actions">
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@prod.Id" class="btn-glass btn-sm-glass">
                        <i class="fas fa-eye"></i> Details
                    </a>
                    <a asp-controller="Product" asp-action="Edit" asp-route-id="@prod.Id" class="btn-glass btn-sm-glass">
                        <i class="fas fa-pen"></i> Edit
                    </a>
                    <button type="button" class="btn-danger-glass btn-sm-glass" data-bs-toggle="modal" data-bs-target="#deleteModal"
                            data-product-id="@prod.Id"
                            data-productName="@prod.Title">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deletModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-exclamation-triangle me-2" style="color:var(--danger);"></i>Delete Product</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete <strong id="productTitle" class="text-gradient">product</strong>?
                <br><small class="text-muted">This action cannot be undone.</small>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn-glass" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn-danger-glass" id="deletBtn">
                    <i class="fas fa-trash"></i> Delete
                </button>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        const deleteModal = document.getElementById('deleteModal');

        deleteModal.addEventListener('show.bs.modal', event => {
            const button = event.relatedTarget;

            const productId = button.getAttribute('data-product-id');
            const productName = button.getAttribute('data-productName');

            document.getElementById('productTitle').textContent = productName;

            document.getElementById('deletBtn').onclick = function() {
                window.location.href = '/Product/Delete/' + productId;
            };
        });
    </script>
}
